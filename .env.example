# ============================================================
# ENVIRONMENT VARIABLES - Plateforme Achats Groupés
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/achats_groupes_db"

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_key_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Twilio (SMS / OTP)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+22600000000

# SendGrid (Email)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@votreplateforme.bf
SENDGRID_FROM_NAME=Achats Groupés BF

# CinetPay (Paiements mobiles Burkina Faso)
CINETPAY_API_KEY=your_cinetpay_api_key
CINETPAY_SITE_ID=your_cinetpay_site_id
CINETPAY_NOTIFY_URL=https://api.votreplateforme.bf/api/v1/payments/webhooks/cinetpay
CINETPAY_RETURN_URL=https://votreplateforme.bf/payment/return

# FedaPay (Alternative paiements)
FEDAPAY_SECRET_KEY=your_stripe_secret_key_here
FEDAPAY_ENVIRONMENT=sandbox

# Redis
REDIS_URL=redis://localhost:6379

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=eu-west-1
AWS_S3_BUCKET=achats-groupes-bf

# Sentry (Monitoring)
SENTRY_DSN=https://xxxxxxxx@sentry.io/xxxxxxx

# BCRYPT
BCRYPT_SALT_ROUNDS=12

# OTP
OTP_EXPIRES_IN_MINUTES=10
